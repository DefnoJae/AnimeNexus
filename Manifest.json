{
  "id": "animenexus",
  "name": "Anime Nexus",
  "version": "0.2.0",
  "manifestURI": "https://raw.githubusercontent.com/DefnoJae/AnimeNexus/main/Manifest.json",
  "language": "typescript",
  "type": "onlinestream-provider",
  "description": "Anime Nexus provider using a local live stream resolver.",
  "author": "DefnoJae",
  "website": "https://anime.nexus/",
  "readme": "https://raw.githubusercontent.com/DefnoJae/AnimeNexus/main/README.md",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/DefnoJae/AnimeNexus/main/payload.ts",
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "name": "resolverUrl",
        "label": "Local resolver URL",
        "type": "text",
        "default": "http://127.0.0.1:3000"
      }
    ]
  }
}
